# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Optional. Enables the Firecrawl provider in scripts/scrape-places.js, which
# adds dog-friendly cafes, beaches and hotels — the category OpenStreetMap
# barely tags. Without it the scraper still runs Overpass/OSM.
#   npm run scrape:all
#
# In CI this is supplied as the repository secret FIRECRAWL_API_KEY instead.
FIRECRAWL_API_KEY=
